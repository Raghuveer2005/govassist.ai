# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=govassist_ai

# JWT Authentication
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Frontend URL (for CORS and email links)
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Automated Email Service Configuration (Nodemailer)
# ==============================================================================
# The email template is stored privately in backend/templates/welcome.html
# and backend/templates/welcome.config.json (editable only by you, not visible on website).
#
# Option A (Recommended for Gmail):
#   1. Go to Google Account > Security > 2-Step Verification > App Passwords.
#   2. Generate a 16-character App Password for "GovAssist".
#   3. Fill in:
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop
# EMAIL_FROM="GovAssist AI" <your_email@gmail.com>
#
# Option B (Custom SMTP: Brevo, SendGrid, Mailgun, AWS SES):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="GovAssist AI" <no-reply@yourdomain.com>
#
# Option C (Development Default):
# Leave EMAIL_USER / SMTP_HOST blank to use Ethereal Email test inbox.
# It prints a live preview link in the terminal on every registration / test email.
